%% 08_deployment -- local deployment: processes, ports, GPU residency and
%% storage. There is NO container, NO proxy and NO TLS in this repository.
%% Three processes, started by hand, on one Windows host.
flowchart TB
  BR(["Browser"]):::io
  subgraph HOST["HOST -- Windows 11, RTX 4070 Ti SUPER, 16,376 MiB"]
    direction LR
    P1["<b>next dev</b><br/>node 24.18.0<br/><b>:3000</b><br/>the only CORS origin"]:::proc
    P2["<b>uvicorn</b><br/>python 3.12.3<br/><b>:8000</b><br/>lifespan loads BiomedCLIP,<br/>EasyOCR, CheXbert,<br/>gate prompt vectors"]:::proc
    P3["<b>ollama 0.34.3</b><br/><b>:11434</b><br/>llama3:8b resident,<br/>keep_alive 30m"]:::proc
  end
  subgraph GPU["GPU residency, measured"]
    direction LR
    G1["llama3:8b<br/>5,025 MiB"]:::mem
    G2["BiomedCLIP<br/>1,043 MiB"]:::mem
    G3["CheXbert<br/>452 MiB"]:::mem
    G4["<b>peak 7,125<br/>of 16,376</b><br/>headroom 9.03 GiB"]:::mem
  end
  subgraph DISK["Storage -- every path anchored to the file, never the CWD"]
    direction LR
    D1[("backend/dev.db<br/>9 tables, 13.5 MB")]:::store
    D2[("chroma_db<br/>2,462 docs")]:::store
    D3[("uploaded_images/<br/><b>masked only</b>")]:::store
    D4[("chexbert.pth 1.31 GB<br/><b>outside the repo</b>")]:::ext
    D5[("HF cache<br/>BiomedCLIP weights")]:::ext
  end
  BR --> P1
  P1 -->|"HTTP, no TLS, cookie"| P2
  P2 --> P3
  P2 --> DISK
  P3 -.- G1
  P2 -.- G2
  P2 -.- G3
  N1["<b>NOT PRESENT:</b> Docker, reverse proxy, TLS, process manager, rate limiting,<br/>secrets management, CI/CD, any Linux run. JWT_SECRET_KEY still defaults to<br/>the dev placeholder in every recorded measurement."]:::warn
  N2["<b>SAFETY:</b> the e2e harness is FAIL-CLOSED -- E2E_DB must name a disposable path.<br/>The screenshots were captured against a COPY on :8011, and dev.db's md5 was<br/>verified unchanged afterwards."]:::warn
